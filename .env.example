# Copy to .env and fill in. Never commit .env.
MONETA_ADDR=:8080
# Password of the moneta database role (scripts/create-db.sql, and the db container with Docker).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://moneta:change-me@localhost:5432/moneta?sslmode=disable
# Built web app to serve on / (production). Leave empty in dev: Vite serves the app and proxies /api.
MONETA_WEB_DIR=
# 32 random bytes, base64. Wraps every user's data key; losing it makes all encrypted data unreadable.
# Generate: openssl rand -base64 32
MONETA_MASTER_KEY=
# Secret used to sign access tokens (32+ random bytes, base64).
MONETA_JWT_SECRET=
# Origin of the web app, for CORS and cookies.
MONETA_WEB_ORIGIN=http://localhost:5173
