# Copy to .env and fill in. Never commit .env.
MONETA_ADDR=:8080
POSTGRES_PASSWORD=change-me
# Used by `go run` outside Docker (compose overrides it for the api container).
DATABASE_URL=postgres://moneta:change-me@localhost:5432/moneta?sslmode=disable
# 32 random bytes, base64. Wraps every user's data key; losing it makes all encrypted data unreadable.
# Generate: openssl rand -base64 32
MONETA_MASTER_KEY=
# Secret used to sign access tokens (32+ random bytes, base64).
MONETA_JWT_SECRET=
# Origin of the web app, for CORS and cookies.
MONETA_WEB_ORIGIN=http://localhost:5173
